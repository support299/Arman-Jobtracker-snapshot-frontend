# Production overrides (used by `npm run build` / deploy.sh)
# Other VITE_* values are inherited from .env unless listed here.

VITE_API_URL=https://snapshot.theservicepilot.com/api
# Must match GHL marketplace redirect URI (backend callback, not SPA route)
VITE_GHL_LOCATION_CONNECT_REDIRECT_PATH=/api/accounts/auth/callback/
